# Copy to .env.local and fill in.

# Public site URL (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Audius: free key from https://api.audius.co/plans
# The API key may be public; the bearer token must stay server-side.
AUDIUS_APP_NAME=Soniva
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=

# Supabase: public values (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
