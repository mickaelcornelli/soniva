# Copier ce fichier en .env.local et compléter.

# URL publique du site (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Audius — clé gratuite à créer sur https://api.audius.co/plans
# La clé API peut être publique ; le bearer token doit rester côté serveur.
AUDIUS_APP_NAME=Soniva
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=

# Supabase — valeurs publiques (protégées par les règles RLS de la base)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
